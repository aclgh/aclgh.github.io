---
import { commentConfig } from '@/config'

interface Props {
  path: string
}

const config = {
  ...commentConfig.twikoo,
  el: '#tcomment',
  path: Astro.props.path,
}
---

<div id="tcomment"></div>
<script is:inline src="https://cdn.jsdelivr.net/npm/twikoo@1.6.40/dist/twikoo.all.min.js"></script>
<script is:inline define:vars={{ config }}>
  function initTwikoo() {
    if (window.twikoo && document.querySelector('#tcomment')) {
      twikoo.init(config)
    }
  }

  initTwikoo()
  document.addEventListener('swup:contentReplaced', initTwikoo)
</script>
